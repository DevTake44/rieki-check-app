# Supabaseダッシュボード → Project Settings → API から取得してください。
# このファイル自体はコピーして .env.local という名前で保存し、実際の値を入れてください。
# .env.local はGitには含めないでください(.gitignoreで除外済みです)。

# Project URL (例: https://bpoxpzihcljebyslmhmd.supabase.co)
SUPABASE_URL=

# service_role キー(絶対にブラウザに渡さない、サーバー側だけで使う秘密の鍵)
SUPABASE_SERVICE_ROLE_KEY=
